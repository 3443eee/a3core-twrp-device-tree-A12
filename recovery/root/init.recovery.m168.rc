on early-boot
    # Create mount point
    mkdir /mnt/socko 0770 root root

    # Mount the socko partition (adjust fs type if needed)
    mount ext4 /dev/block/by-name/socko /mnt/socko

    # Use exec to run a shell loop that loads all .ko modules
    exec u:r:init:s0 root root -- /system/bin/sh -c '
        for module in /mnt/socko/*.ko; do
            if [ -f "$module" ]; then
                echo "Loading module: $module"
                insmod "$module" || echo "Failed to load: $module"
            fi
        done
    '

    # Default permissions
    chown system system /dev/tspio
    chown system system /sys/class/sec/tsp/enable
on init
    # from recovery: init.recovery.samsung.rc
    # unlink /efs > /mnt/vendor/efs
    rm /efs
    mkdir /efs
    mkdir /sec_efs

    chown system root /proc/cpwcn/wdtirq
    chmod 766 /proc/cpwcn/wdtirq

on post-fs
    chown system system sys/class/sec/tsp/input/enabled
    chmod 664 sys/class/sec/tsp/input/enabled

on post-fs-data
    chown system system /proc/tp_gesture
    chmod 0660 /proc/tp_gesture
    chown system system /proc/icn85xx_tool
    chmod 0660 /proc/icn85xx_tool
