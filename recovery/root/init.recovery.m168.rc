on early-boot

    insmod /vendor/lib/modules/nt36xxx.ko
    insmod /vendor/lib/modules/nt36xxx_ss.ko
    insmod /vendor/lib/modules/chipone-tddi.ko
    insmod /vendor/lib/modules/chipone-tddi_ss.ko
    insmod /vendor/lib/modules/gcore.ko
    insmod /vendor/lib/modules/gcore_ss.ko
    insmod /vendor/lib/modules/gcore_7202h.ko
    insmod /vendor/lib/modules/ilitek-tddi.ko
    insmod /vendor/lib/modules/focaltech_ts.ko
    insmod /vendor/lib/modules/tcs3430.ko


    insmod /vendor/lib/modules/ant_check_div.ko
    insmod /vendor/lib/modules/microarray_fp.ko
    insmod /vendor/lib/modules/sunwave_sw9058g_fp.ko
    insmod /vendor/lib/modules/flash_ic_aw3641.ko
    insmod /vendor/lib/modules/flash_ic_ocp8137.ko
    insmod /vendor/lib/modules/flash_ic_sc2703.ko
    insmod /vendor/lib/modules/flash_ic_syx378duc.ko
    insmod /vendor/lib/modules/pvrsrvkm.ko
    insmod /vendor/lib/modules/sprdbt_tty.ko
    insmod /vendor/lib/modules/sprd_camera.ko
    insmod /vendor/lib/modules/sprd_cpp.ko
    insmod /vendor/lib/modules/sprd_flash_drv.ko
    insmod /vendor/lib/modules/sprd_fm.ko
    insmod /vendor/lib/modules/sprd_sensor.ko
    insmod /vendor/lib/modules/sprdwl_ng.ko

    # Default permissions
    chown system system /dev/tspio
    chown system system /sys/class/sec/tsp/enable

on init
    # from recovery: init.recovery.samsung.rc
    # unlink /efs > /mnt/vendor/efs
    rm /efs
    mkdir /efs
    mkdir /sec_efs

    chown system root /proc/cpwcn/wdtirq
    chmod 766 /proc/cpwcn/wdtirq

on post-fs
    chown system system sys/class/sec/tsp/input/enabled
    chmod 664 sys/class/sec/tsp/input/enabled

on post-fs-data
    chown system system /proc/tp_gesture
    chmod 0660 /proc/tp_gesture
    chown system system /proc/icn85xx_tool
    chmod 0660 /proc/icn85xx_tool
